{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Signal Interpreter",
  "version": "0.10.38",
  "description": "Asistente independiente para interpretación médica en tiempo real; subtítulos bilingües de baja latencia, verificación de teléfonos y direcciones, y acceso rápido a Linguee.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "webRequest",
    "scripting",
    "nativeMessaging",
    "idle"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://app.cloudinterpreter.com/*",
    "https://api.frankfurter.app/*",
    "https://api.frankfurter.dev/*",
    "https://open.er-api.com/*",
    "https://api.exchangerate.fun/*",
    "https://signal-interpreter-observability-re.vercel.app/*"
  ],
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.cloudinterpreter.com/*"
      ],
      "js": [
        "extension/mic-guard-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.cloudinterpreter.com/*"
      ],
      "js": [
        "extension/live-caption-core.js",
        "extension/live-caption-overlay.js",
        "extension/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "extension/global-mouse-gesture.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "extension/hotkey-fallback.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://app.cloudinterpreter.com/*"
      ],
      "js": [
        "extension/live-caption-core.js",
        "extension/live-caption-overlay.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://app.cloudinterpreter.com/auth/signin*"
      ],
      "js": [
        "extension/auth-signin-assist.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Signal Interpreter",
    "default_popup": "extension/ui/popup.html",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "32": "extension/icons/icon32.png",
      "48": "extension/icons/icon48.png"
    }
  },
  "commands": {
    "toggle-extension-microphone": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Silenciar o activar el micrófono de Signal Interpreter. Ctrl+Shift+."
    },
    "toggle-auto-answer": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Activar o desactivar Auto-Answer"
    },
    "toggle-global-overlays": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "Mostrar u ocultar ambos overlays sin detener la llamada"
    }
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "32": "extension/icons/icon32.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://signal-interpreter-observability-re.vercel.app https://api.exchangerate.fun https://api.frankfurter.app https://api.frankfurter.dev https://open.er-api.com"
  },
  "key": ""
}
