{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Signal Interpreter",
  "version": "0.10.12",
  "description": "Asistente independiente para interpretación médica en tiempo real; Auto-Answer, observabilidad y métricas para Cloud Interpreter.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "tabCapture",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "webRequest",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://app.cloudinterpreter.com/*",
    "https://api.frankfurter.app/*",
    "https://api.frankfurter.dev/*",
    "https://open.er-api.com/*",
    "https://api.groq.com/*",
    "https://api.exchangerate.fun/*",
    "https://signal-interpreter-observability-re.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.cloudinterpreter.com/*"
      ],
      "js": [
        "mic-guard-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.cloudinterpreter.com/*"
      ],
      "js": [
        "live-caption-core.js",
        "live-caption-overlay.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "global-mouse-gesture.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Signal Interpreter",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-extension-microphone": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "FORCE MUTE del micrófono de Signal Interpreter. Ctrl+Shift+."
    },
    "toggle-auto-answer": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Activar o desactivar Auto-Answer"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://signal-interpreter-observability-re.vercel.app https://api.exchangerate.fun https://api.groq.com https://api.frankfurter.app https://api.frankfurter.dev https://open.er-api.com"
  },
  "key": ""
}
