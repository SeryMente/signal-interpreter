{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Signal Interpreter",
  "version": "0.9.0",
  "description": "Asistente independiente para interpretación médica en tiempo real; Auto-Answer, observabilidad y métricas para Cloud Interpreter.",
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "https://app.cloudinterpreter.com/*",
    "https://api.frankfurter.app/*",
    "https://api.frankfurter.dev/*",
    "https://open.er-api.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.cloudinterpreter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Signal Interpreter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-auto-answer": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Activar o desactivar Auto-Answer"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8787 http://127.0.0.1:8787"
  }
}
